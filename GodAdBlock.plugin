#!name=人工智障·去广告
#!desc=v2.2.0：2126 条域名规则 + 92 条单 App 净化/开屏脚本（16 个开关，需 MITM）。覆盖微博/小红书/知乎/爱奇艺/优酷/滴滴/淘宝/京东/什么值得买/菜鸟/酷安/百度地图/夸克/航旅纵横，及 X(Twitter) iOS App/网页版（实验组）。看广告得奖励类功能会受影响。
#!author=人工智障 (Muse)
#!icon=https://raw.githubusercontent.com/YikR/loon-adblock/main/icon.png
#!homepage=https://github.com/YikR/loon-adblock
#!raw-url=https://raw.githubusercontent.com/YikR/loon-adblock/main/GodAdBlock.plugin
#!tag=去广告,定制
#!system=iOS, iPadOS
#!date=2026-10-23
#!version=2.2.0

# ============================================================
# 说明（v2.1）
# [Rule] 2126 条 = v1 手工精选 45 条 + fmz200/wool_scripts 的 rejectAd
#   域名部分（DOMAIN 245 + DOMAIN-SUFFIX 1737 + DOMAIN-KEYWORD 98），
#   已做：去重、覆盖去冗（441 条子域被父后缀覆盖后删除）、安全过滤
#   （剔除 Adobe 激活/安全浏览类 27 条、上游误收的 temu.com 本体 1 条、
#   格式非法 5 条）；受保护的正文大域（qq.com / baidu.com / bilibili.com
#   等）本体一条都没有，只拦它们的广告子域名。v2.1 另从 blackmatrix7
#   Advertising 关键词中精选 46 条补强（admob/adserver/supersonicads 等）。
#   anti-AD（11.2 万条）是给 DNS 解析器调的，未整表导入（手机规则引擎
#   性能与误伤权衡），仅作交叉核对：本表 1467 条与它重合。
# [Rewrite]/[Script] 为单 App 净化层（92 条脚本、16 个开关），来源
#   fmz200（微博/小红书/知乎/爱奇艺/优酷/滴滴/淘宝/京东/什么值得买/
#   菜鸟/酷安/百度地图/夸克/航旅纵横，及 X 的 X_ads.js——原为网页版写、
#   v2.2 起同时挂到 iOS App 的 api.twitter.com/api.x.com 接口上，属
#   实验组：App 改接口或加证书锁定时会失效，失效时关 x_enable 即可）
#   与 blackmatrix7（开屏 startup.js），
#   需要 MITM 证书并信任；没开 MITM 时这层不生效，[Rule] 层照常工作。
# 某 App 异常：先关对应脚本开关，再关整个插件定位；「看广告领奖励」
#   的激励视频会被拦，属原理决定。
# ============================================================

[Argument]
startup_enable = switch,true,tag=开屏脚本（B站/爱奇艺/美团外卖等）,desc=blackmatrix7 startup.js，需 MITM
weibo_enable = switch,true,tag=微博净化脚本,desc=fmz200 weibo_main/weibo_ads，需 MITM
xhs_enable = switch,true,tag=小红书净化脚本,desc=fmz200 xiaohongshu.js，需 MITM
zhihu_enable = switch,true,tag=知乎净化脚本,desc=fmz200 zhihu.js，需 MITM
iqiyi_enable = switch,true,tag=爱奇艺净化脚本,desc=fmz200 cnftp.js，需 MITM
smzdm_enable = switch,true,tag=什么值得买净化脚本,desc=fmz200 smzdm 系列，需 MITM
didi_enable = switch,true,tag=滴滴出行净化脚本,desc=fmz200 didiAds.js，需 MITM
youku_enable = switch,true,tag=优酷净化脚本,desc=fmz200 cnftp.js，需 MITM
coolapk_enable = switch,true,tag=酷安净化脚本,desc=fmz200 coolapk.js，需 MITM
cainiao_enable = switch,true,tag=菜鸟裹裹净化脚本,desc=fmz200 cainiao.js，需 MITM
taobao_enable = switch,true,tag=淘宝净化脚本,desc=fmz200 myBlockAds.js，需 MITM
jd_enable = switch,true,tag=京东净化脚本,desc=fmz200 jingdong.js，需 MITM
baidumap_enable = switch,true,tag=百度地图净化脚本,desc=fmz200 baidumap.js，需 MITM
quark_enable = switch,true,tag=夸克净化脚本,desc=fmz200 quark.js，需 MITM
umetrip_enable = switch,true,tag=航旅纵横净化脚本,desc=fmz200 umetrip_ads.js，需 MITM
x_enable = switch,true,tag=X(Twitter)去广告（实验）,desc=fmz200 X_ads.js，同时挂 iOS App 与网页版时间线接口，需 MITM

